# Copy to .env to override defaults for local (non-compose) runs:
#   cp .env.example .env && set -a && . ./.env && set +a
# Every variable is optional; the values below are the defaults.

LOG_LEVEL=info                      # debug | info | warn | error

DATABASE_URL=postgres://notifications:notifications@localhost:5432/notifications?sslmode=disable
DB_MAX_CONNS=10                     # Postgres pool size per process
REDIS_URL=redis://localhost:6379/0

API_ADDR=:8080
WORKER_ADMIN_ADDR=:8082
SHUTDOWN_TIMEOUT=15s                # max wait for in-flight work after SIGTERM

# Provider endpoint. Default is the local mock; use your own
# https://webhook.site/<uuid> to test against a real HTTP endpoint.
PROVIDER_URL=http://localhost:8090/send

# Validation limits (characters, counted as Unicode runes)
SMS_MAX_CHARS=160                   # one GSM-7 segment; multipart SMS is future work
EMAIL_MAX_CHARS=10000
PUSH_MAX_CHARS=256
PUSH_TOKEN_MAX_CHARS=512
BATCH_MAX_SIZE=1000                 # items per POST /notifications/batch
MAX_ATTEMPTS=5                      # delivery attempts before a notification fails

# Worker (delivery engine)
WORKER_CONCURRENCY=10               # parallel provider calls per channel
CLAIM_BATCH_SIZE=10                 # max rows claimed per query
POLL_INTERVAL=500ms                 # idle wait between empty claims
LEASE_DURATION=30s                  # must be >= 2 x PROVIDER_TIMEOUT
REAPER_INTERVAL=10s                 # how often expired leases are re-queued
PROVIDER_TIMEOUT=5s                 # per-attempt HTTP timeout
RETRY_BASE_DELAY=2s                 # delay before retrying a retryable failure

# Rate limiting (Redis token bucket per channel, shared by all worker replicas)
RATE_LIMIT_SMS_PER_SECOND=100
RATE_LIMIT_EMAIL_PER_SECOND=100
RATE_LIMIT_PUSH_PER_SECOND=100
RATE_LIMIT_BURST=10                 # bucket capacity; max back-to-back sends after idle

# Mock provider (cmd/mockprovider)
MOCK_ADDR=:8090
MOCK_LATENCY_MIN=20ms
MOCK_LATENCY_MAX=120ms
MOCK_FAILURE_RATE=0.1               # probability 0..1 of a random failure
MOCK_FAILURE_CODES=500,503,429      # picked uniformly when a failure is injected
MOCK_RETRY_AFTER=0s                 # Retry-After sent with 429/503 (0 = none)
